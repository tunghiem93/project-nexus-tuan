// =============================================================================
// Project Nexus — ALL MODULES (combined ERD for dbdiagram.io)
// Import: https://dbdiagram.io → New Diagram → Paste this file
// Database: SQL Server 2026 | 6 databases (microservices)
// =============================================================================

Project Nexus {
  database_type: 'SQL Server'
  Note: '''
    # Project Nexus ERD
    Mỗi TableGroup = 1 database riêng (SRS 4.1).
    Ref nét đứt (cross-module) = tham chiếu logic, KHÔNG có FK thật cross-DB.
  '''
}

// =============================================================================
// MODULE 1: User Service — Nexus_User
// =============================================================================

TableGroup Nexus_User {
  user_privileges
  user_roles_tbl
  user_role_privileges
  user_users
  user_user_roles
  user_user_sessions
  user_login_attempts
  user_password_reset_tokens
  user_reputation_scores
  user_reputation_ratings
  user_reputation_penalties
  user_reputation_transaction_summary
  user_audit_logs
  user_outbox_events
}

Table user_privileges {
  id uuid [pk, default: `NEWSEQUENTIALID()`]
  code varchar(100) [unique, not null, note: 'e.g. PRODUCT.CREATE']
  description text
  created_at datetime [not null, default: `SYSDATETIMEOFFSET()`]
}

Table user_roles_tbl {
  id uuid [pk, default: `NEWSEQUENTIALID()`]
  code varchar(50) [unique, not null]
  name varchar(100) [not null]
  description text
  is_system boolean [not null, default: false]
  deleted_at datetime
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table user_role_privileges {
  role_id uuid [not null]
  privilege_id uuid [not null]
  indexes {
    (role_id, privilege_id) [pk]
  }
}

Table user_users {
  id uuid [pk, default: `NEWSEQUENTIALID()`]
  email varchar(255) [unique, not null]
  phone varchar(20) [not null]
  username varchar(100) [unique, not null]
  password_hash varchar(255) [not null]
  full_name varchar(200) [not null]
  identify_number varchar(50) [not null]
  gender varchar(20) [not null, default: 'UNSPECIFIED']
  address text [not null]
  date_of_birth date [not null]
  status varchar(20) [not null, default: 'ACTIVE']
  deleted_at datetime
  created_at datetime [not null]
  updated_at datetime [not null]
  created_by uuid
  updated_by uuid
}

Table user_user_roles {
  user_id uuid [not null]
  role_id uuid [not null]
  assigned_at datetime [not null]
  assigned_by uuid
  indexes {
    (user_id, role_id) [pk]
  }
}

Table user_user_sessions {
  id uuid [pk]
  user_id uuid [not null]
  refresh_token varchar(512) [unique, not null]
  access_jti varchar(64)
  ip_address varchar(45)
  user_agent text
  expires_at datetime [not null]
  revoked_at datetime
  created_at datetime [not null]
}

Table user_login_attempts {
  id uuid [pk]
  username varchar(100) [not null]
  ip_address varchar(45)
  success boolean [not null]
  attempted_at datetime [not null]
}

Table user_password_reset_tokens {
  id uuid [pk]
  user_id uuid [not null]
  token_hash varchar(255) [unique, not null]
  expires_at datetime [not null]
  used_at datetime
  created_at datetime [not null]
}

Table user_reputation_scores {
  user_id uuid [pk]
  score decimal(5,2) [not null, default: 50.00]
  trust_level varchar(20) [not null, default: 'MEDIUM']
  total_ratings int [not null, default: 0]
  avg_rating decimal(3,2)
  penalty_count int [not null, default: 0]
  last_calculated_at datetime [not null]
  updated_at datetime [not null]
}

Table user_reputation_ratings {
  id uuid [pk]
  rater_id uuid [not null]
  ratee_id uuid [not null]
  transaction_type varchar(20) [not null, note: 'ORDER | AUCTION']
  transaction_ref_id uuid [not null, note: 'logical ref order/auction']
  score smallint [not null]
  comment text
  dispute_flag boolean [not null, default: false]
  created_at datetime [not null]
  indexes {
    (rater_id, transaction_type, transaction_ref_id) [unique]
  }
}

Table user_reputation_penalties {
  id uuid [pk]
  user_id uuid [not null]
  penalty_type varchar(50) [not null]
  score_delta decimal(5,2) [not null]
  reason text [not null]
  reference_type varchar(30)
  reference_id uuid
  applied_by uuid
  applied_at datetime [not null]
}

Table user_reputation_transaction_summary {
  user_id uuid [pk]
  completed_orders int [not null, default: 0]
  cancelled_orders int [not null, default: 0]
  auctions_won int [not null, default: 0]
  auctions_lost_payment int [not null, default: 0]
  updated_at datetime [not null]
}

Table user_audit_logs {
  id uuid [pk]
  actor_id uuid
  action varchar(100) [not null]
  entity_type varchar(50) [not null]
  entity_id uuid
  old_value text [note: 'JSON']
  new_value text [note: 'JSON']
  ip_address varchar(45)
  created_at datetime [not null]
}

Table user_outbox_events {
  id uuid [pk]
  aggregate_type varchar(50) [not null]
  aggregate_id uuid [not null]
  event_type varchar(100) [not null]
  payload text [not null, note: 'JSON']
  published_at datetime
  created_at datetime [not null]
}

Ref: user_role_privileges.role_id > user_roles_tbl.id
Ref: user_role_privileges.privilege_id > user_privileges.id
Ref: user_user_roles.user_id > user_users.id
Ref: user_user_roles.role_id > user_roles_tbl.id
Ref: user_user_sessions.user_id > user_users.id
Ref: user_password_reset_tokens.user_id > user_users.id
Ref: user_reputation_scores.user_id - user_users.id
Ref: user_reputation_ratings.rater_id > user_users.id
Ref: user_reputation_ratings.ratee_id > user_users.id
Ref: user_reputation_penalties.user_id > user_users.id
Ref: user_reputation_penalties.applied_by > user_users.id
Ref: user_reputation_transaction_summary.user_id - user_users.id

// =============================================================================
// MODULE 2: Catalog Service — Nexus_Catalog
// =============================================================================

TableGroup Nexus_Catalog {
  catalog_categories
  catalog_products
  catalog_product_images
  catalog_product_discovery_stats
  catalog_outbox_events
}

Table catalog_categories {
  id uuid [pk]
  parent_id uuid
  name varchar(200) [not null]
  slug varchar(200) [unique, not null]
  description text
  level smallint [not null, note: 'max 3']
  sort_order int [not null, default: 0]
  deleted_at datetime
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table catalog_products {
  id uuid [pk]
  seller_id uuid [not null, note: 'logical ref Nexus_User.users']
  sku_code varchar(100) [not null]
  name varchar(300) [not null]
  slug varchar(300) [not null]
  description text
  base_price decimal(14,2) [not null]
  currency char(3) [not null, default: 'VND']
  status varchar(20) [not null, default: 'DRAFT']
  auction_enabled boolean [not null, default: true]
  category_id uuid [not null]
  deleted_at datetime
  created_at datetime [not null]
  updated_at datetime [not null]
  indexes {
    (seller_id, sku_code) [unique]
  }
}

Table catalog_product_images {
  id uuid [pk]
  product_id uuid [not null]
  url text [not null]
  sort_order smallint [not null, default: 0, note: '0-4 max 5 images']
  created_at datetime [not null]
}

Table catalog_product_discovery_stats {
  product_id uuid [pk]
  view_count bigint [not null, default: 0]
  order_count bigint [not null, default: 0]
  popularity_score decimal(10,4) [not null, default: 0]
  updated_at datetime [not null]
}

Table catalog_outbox_events {
  id uuid [pk]
  aggregate_type varchar(50) [not null]
  aggregate_id uuid [not null]
  event_type varchar(100) [not null]
  payload text [not null]
  published_at datetime
  created_at datetime [not null]
}

Ref: catalog_categories.parent_id > catalog_categories.id
Ref: catalog_products.category_id > catalog_categories.id
Ref: catalog_product_images.product_id > catalog_products.id
Ref: catalog_product_discovery_stats.product_id - catalog_products.id

// =============================================================================
// MODULE 3: Commerce Service — Nexus_Commerce
// =============================================================================

TableGroup Nexus_Commerce {
  commerce_carts
  commerce_cart_items
  commerce_checkout_sessions
  commerce_orders
  commerce_order_items
  commerce_order_status_history
  commerce_payments
  commerce_payment_attempts
  commerce_refunds
  commerce_outbox_events
}

Table commerce_carts {
  id uuid [pk]
  user_id uuid [note: 'logical ref Nexus_User.users']
  guest_token varchar(64)
  status varchar(20) [not null, default: 'ACTIVE']
  currency char(3) [not null, default: 'VND']
  subtotal decimal(14,2) [not null, default: 0]
  tax_amount decimal(14,2) [not null, default: 0]
  discount_amount decimal(14,2) [not null, default: 0]
  shipping_estimate decimal(14,2) [not null, default: 0]
  expires_at datetime [not null]
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table commerce_cart_items {
  id uuid [pk]
  cart_id uuid [not null]
  product_id uuid [not null, note: 'logical ref Nexus_Catalog.products']
  sku_code varchar(100) [not null]
  product_name varchar(300) [not null]
  unit_price decimal(14,2) [not null]
  quantity int [not null]
  line_total decimal(14,2) [not null]
  created_at datetime [not null]
  updated_at datetime [not null]
  indexes {
    (cart_id, product_id) [unique]
  }
}

Table commerce_checkout_sessions {
  id uuid [pk]
  cart_id uuid [not null]
  user_id uuid [not null]
  status varchar(20) [not null, default: 'STARTED']
  shipping_address text [not null, note: 'JSON']
  payment_method varchar(30) [not null, default: 'STRIPE']
  price_snapshot text [not null, note: 'JSON']
  reservation_refs text [note: 'JSON array of reservation IDs']
  expires_at datetime [not null]
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table commerce_orders {
  id uuid [pk]
  order_number varchar(30) [unique, not null]
  buyer_id uuid [not null, note: 'logical ref Nexus_User.users']
  seller_id uuid [note: 'logical ref Nexus_User.users']
  source varchar(20) [not null, default: 'CART_CHECKOUT']
  source_ref_id uuid [note: 'checkout_session or auction_settlement']
  status varchar(30) [not null, default: 'PENDING_PAYMENT']
  currency char(3) [not null, default: 'VND']
  subtotal decimal(14,2) [not null]
  tax_amount decimal(14,2) [not null, default: 0]
  discount_amount decimal(14,2) [not null, default: 0]
  shipping_fee decimal(14,2) [not null, default: 0]
  total_amount decimal(14,2) [not null]
  shipping_address text [not null, note: 'JSON']
  payment_deadline datetime
  idempotency_key varchar(64) [unique]
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table commerce_order_items {
  id uuid [pk]
  order_id uuid [not null]
  product_id uuid [not null]
  sku_code varchar(100) [not null]
  product_name varchar(300) [not null]
  unit_price decimal(14,2) [not null]
  quantity int [not null]
  line_total decimal(14,2) [not null]
}

Table commerce_order_status_history {
  id uuid [pk]
  order_id uuid [not null]
  from_status varchar(30)
  to_status varchar(30) [not null]
  reason text
  changed_by uuid
  changed_at datetime [not null]
}

Table commerce_payments {
  id uuid [pk]
  order_id uuid [not null]
  provider varchar(30) [not null, default: 'STRIPE']
  provider_payment_id varchar(100)
  amount decimal(14,2) [not null]
  currency char(3) [not null, default: 'VND']
  status varchar(20) [not null, default: 'INITIATED']
  idempotency_key varchar(64) [unique, not null]
  metadata text [note: 'JSON']
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table commerce_payment_attempts {
  id uuid [pk]
  payment_id uuid [not null]
  attempt_no smallint [not null]
  status varchar(20) [not null]
  error_code varchar(50)
  error_message text
  attempted_at datetime [not null]
}

Table commerce_refunds {
  id uuid [pk]
  order_id uuid [not null]
  payment_id uuid [not null]
  amount decimal(14,2) [not null]
  reason text
  status varchar(20) [not null, default: 'REQUESTED']
  provider_refund_id varchar(100)
  requested_by uuid [not null]
  idempotency_key varchar(64) [unique]
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table commerce_outbox_events {
  id uuid [pk]
  aggregate_type varchar(50) [not null]
  aggregate_id uuid [not null]
  event_type varchar(100) [not null]
  payload text [not null]
  published_at datetime
  created_at datetime [not null]
}

Ref: commerce_cart_items.cart_id > commerce_carts.id
Ref: commerce_checkout_sessions.cart_id > commerce_carts.id
Ref: commerce_order_items.order_id > commerce_orders.id
Ref: commerce_order_status_history.order_id > commerce_orders.id
Ref: commerce_payments.order_id > commerce_orders.id
Ref: commerce_payment_attempts.payment_id > commerce_payments.id
Ref: commerce_refunds.order_id > commerce_orders.id
Ref: commerce_refunds.payment_id > commerce_payments.id

// =============================================================================
// MODULE 4: Auction Service — Nexus_Auction
// =============================================================================

TableGroup Nexus_Auction {
  auction_auctions
  auction_bids
  auction_extensions
  auction_settlements
  auction_processed_events
  auction_outbox_events
}

Table auction_auctions {
  id uuid [pk]
  product_id uuid [not null, note: 'logical ref Nexus_Catalog.products']
  seller_id uuid [not null, note: 'logical ref Nexus_User.users']
  sku_code varchar(100) [not null]
  status varchar(20) [not null, default: 'DRAFT']
  visibility varchar(20) [not null, default: 'PUBLIC']
  starting_price decimal(14,2) [not null]
  bid_increment decimal(14,2) [not null, default: 10]
  current_price decimal(14,2)
  current_bidder_id uuid
  bid_count int [not null, default: 0]
  scheduled_start_at datetime [not null]
  scheduled_end_at datetime [not null]
  actual_start_at datetime
  actual_end_at datetime
  extension_count int [not null, default: 0]
  inventory_reservation_id uuid [note: 'logical ref Nexus_Fulfillment.inventory_reservations']
  cancelled_by uuid
  cancel_reason text
  version bigint [not null, default: 0, note: 'optimistic lock']
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table auction_bids {
  id uuid [pk]
  auction_id uuid [not null]
  bidder_id uuid [not null, note: 'logical ref Nexus_User.users']
  amount decimal(14,2) [not null]
  is_winning boolean [not null, default: false]
  idempotency_key varchar(64) [unique]
  placed_at datetime [not null]
}

Table auction_extensions {
  id uuid [pk]
  auction_id uuid [not null]
  trigger_bid_id uuid [not null]
  previous_end_at datetime [not null]
  new_end_at datetime [not null]
  extension_minutes int [not null, default: 5]
  created_at datetime [not null]
}

Table auction_settlements {
  id uuid [pk]
  auction_id uuid [unique, not null]
  status varchar(20) [not null]
  winner_id uuid
  winning_bid_id uuid
  final_price decimal(14,2)
  payment_deadline datetime
  settled_at datetime
  settlement_payload text [note: 'JSON sent to Commerce']
  idempotency_key varchar(64) [unique]
  created_at datetime [not null]
}

Table auction_processed_events {
  event_id varchar(100) [pk]
  processed_at datetime [not null]
}

Table auction_outbox_events {
  id uuid [pk]
  aggregate_type varchar(50) [not null]
  aggregate_id uuid [not null]
  event_type varchar(100) [not null]
  payload text [not null]
  published_at datetime
  created_at datetime [not null]
}

Ref: auction_bids.auction_id > auction_auctions.id
Ref: auction_extensions.auction_id > auction_auctions.id
Ref: auction_extensions.trigger_bid_id > auction_bids.id
Ref: auction_settlements.auction_id - auction_auctions.id
Ref: auction_settlements.winning_bid_id > auction_bids.id

// =============================================================================
// MODULE 5: Fulfillment Service — Nexus_Fulfillment
// =============================================================================

TableGroup Nexus_Fulfillment {
  fulfillment_warehouses
  fulfillment_inventory_records
  fulfillment_inventory_reservations
  fulfillment_inventory_ledger
  fulfillment_shipments
  fulfillment_shipment_status_history
  fulfillment_carrier_performance
  fulfillment_processed_events
  fulfillment_outbox_events
}

Table fulfillment_warehouses {
  id uuid [pk]
  code varchar(20) [unique, not null, note: 'WH_001']
  name varchar(200) [not null]
  address text
  is_active boolean [not null, default: true]
  created_at datetime [not null]
}

Table fulfillment_inventory_records {
  id uuid [pk]
  sku_code varchar(100) [not null]
  warehouse_id uuid [not null]
  total_quantity int [not null, default: 0]
  available_quantity int [not null, default: 0]
  reserved_quantity int [not null, default: 0]
  unavailable_quantity int [not null, default: 0]
  version bigint [not null, default: 0]
  updated_at datetime [not null]
  indexes {
    (sku_code, warehouse_id) [unique]
  }
}

Table fulfillment_inventory_reservations {
  id uuid [pk]
  sku_code varchar(100) [not null]
  warehouse_id uuid [not null]
  quantity int [not null]
  reference_type varchar(30) [not null, note: 'CHECKOUT|AUCTION|ORDER']
  reference_id uuid [not null]
  status varchar(20) [not null, default: 'ACTIVE']
  expires_at datetime [not null]
  idempotency_key varchar(64) [unique]
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table fulfillment_inventory_ledger {
  id uuid [pk]
  sku_code varchar(100) [not null]
  warehouse_id uuid [not null]
  movement_type varchar(20) [not null]
  quantity_delta int [not null]
  reference_type varchar(30)
  reference_id uuid
  note text
  created_at datetime [not null, note: 'immutable']
}

Table fulfillment_shipments {
  id uuid [pk]
  order_id uuid [not null, note: 'logical ref Nexus_Commerce.orders']
  warehouse_id uuid [not null]
  carrier_code varchar(20) [not null, note: 'GHN|GHTK']
  service_type varchar(50)
  tracking_number varchar(100)
  shipping_fee decimal(14,2) [not null, default: 0]
  status varchar(30) [not null, default: 'CREATED']
  recipient_address text [not null, note: 'JSON']
  carrier_raw_status varchar(100)
  idempotency_key varchar(64) [unique]
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table fulfillment_shipment_status_history {
  id uuid [pk]
  shipment_id uuid [not null]
  from_status varchar(30)
  to_status varchar(30) [not null]
  source varchar(30) [not null]
  raw_payload text [note: 'JSON']
  changed_at datetime [not null]
}

Table fulfillment_carrier_performance {
  id uuid [pk]
  carrier_code varchar(20) [unique, not null]
  total_shipments int [not null, default: 0]
  delivered_count int [not null, default: 0]
  failed_count int [not null, default: 0]
  avg_delivery_hours decimal(8,2)
  updated_at datetime [not null]
}

Table fulfillment_processed_events {
  event_id varchar(100) [pk]
  processed_at datetime [not null]
}

Table fulfillment_outbox_events {
  id uuid [pk]
  aggregate_type varchar(50) [not null]
  aggregate_id uuid [not null]
  event_type varchar(100) [not null]
  payload text [not null]
  published_at datetime
  created_at datetime [not null]
}

Ref: fulfillment_inventory_records.warehouse_id > fulfillment_warehouses.id
Ref: fulfillment_inventory_reservations.warehouse_id > fulfillment_warehouses.id
Ref: fulfillment_inventory_ledger.warehouse_id > fulfillment_warehouses.id
Ref: fulfillment_shipments.warehouse_id > fulfillment_warehouses.id
Ref: fulfillment_shipment_status_history.shipment_id > fulfillment_shipments.id

// =============================================================================
// MODULE 6: Notification Service — Nexus_Notification
// =============================================================================

TableGroup Nexus_Notification {
  notification_event_logs
  notification_processed_events
  notification_templates
  notification_notifications
  notification_deliveries
  notification_preferences
  notification_broker_health_logs
  notification_outbox_events
}

Table notification_event_logs {
  id uuid [pk]
  event_type varchar(100) [not null]
  event_message text [not null]
  operator_id uuid
  operator_name varchar(200)
  source_service varchar(50)
  payload text [note: 'JSON']
  correlation_id varchar(64)
  created_at datetime [not null]
}

Table notification_processed_events {
  event_id varchar(100) [pk]
  processed_at datetime [not null]
}

Table notification_templates {
  id uuid [pk]
  event_type varchar(100) [not null]
  channel varchar(10) [not null, note: 'EMAIL|PUSH|SMS']
  subject varchar(300)
  body_template text [not null]
  is_transactional boolean [not null, default: false]
  created_at datetime [not null]
  indexes {
    (event_type, channel) [unique]
  }
}

Table notification_notifications {
  id uuid [pk]
  user_id uuid [not null, note: 'logical ref Nexus_User.users']
  event_type varchar(100) [not null]
  title varchar(300) [not null]
  body text [not null]
  is_transactional boolean [not null, default: false]
  metadata text [note: 'JSON']
  created_at datetime [not null]
}

Table notification_deliveries {
  id uuid [pk]
  notification_id uuid [not null]
  channel varchar(10) [not null]
  status varchar(10) [not null, default: 'PENDING']
  attempt_count smallint [not null, default: 0]
  last_error text
  sent_at datetime
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table notification_preferences {
  id uuid [pk]
  user_id uuid [not null]
  event_type varchar(100) [not null]
  channel varchar(10) [not null]
  enabled boolean [not null, default: true]
  updated_at datetime [not null]
  indexes {
    (user_id, event_type, channel) [unique]
  }
}

Table notification_broker_health_logs {
  id uuid [pk]
  broker_name varchar(50) [not null, default: 'rabbitmq']
  status varchar(20) [not null]
  detail text
  checked_at datetime [not null]
}

Table notification_outbox_events {
  id uuid [pk]
  aggregate_type varchar(50) [not null]
  aggregate_id uuid [not null]
  event_type varchar(100) [not null]
  payload text [not null]
  published_at datetime
  created_at datetime [not null]
}

Ref: notification_deliveries.notification_id > notification_notifications.id

// =============================================================================
// Cross-module logical references (optional — bật nếu muốn thấy liên kết giữa services)
// =============================================================================

// Ref: catalog_products.seller_id > user_users.id
// Ref: commerce_carts.user_id > user_users.id
// Ref: commerce_orders.buyer_id > user_users.id
// Ref: auction_auctions.product_id > catalog_products.id
// Ref: fulfillment_shipments.order_id > commerce_orders.id
// Ref: notification_notifications.user_id > user_users.id
